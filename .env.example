# cp .env.example .env — compose refuses to start without GITLAB_ROOT_PASSWORD.
# Min 8 chars, and GitLab rejects anything on its common-password list.
GITLAB_ROOT_PASSWORD=change-me-locally-8chars

# Read by gitboard as well as docker compose. Gitignored, so a token is fine
# here — `gitboard.toml` refuses one because that file is meant to be shared.
# A real exported env var still wins over anything in this file.
GITLAB_URL=http://localhost:8929
GITLAB_TOKEN=glpat-seedseedseedseedseed
